# Flask Application Settings
PORT=5000
FLASK_DEBUG=false
SECRET_KEY=ambulance-management-secret-pat4

# Default Admin Credentials
APP_USERNAME=admin
APP_PASSWORD=admin123

# Oracle Database Connection Settings
DB_USER=user
DB_PASSWORD=pswd
DB_HOST=localhost
